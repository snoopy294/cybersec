APP_NAME=SENTINEL
APP_VERSION=0.1.0
DEBUG=false

# Comma-separated list of allowed browser origins.
# Local: http://localhost:3000
# Production: https://your-vercel-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# Local default can be omitted. Production should use a managed Postgres URL.
# Render commonly provides postgresql://...; the app normalizes it for async use.
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# Optional. Leave blank to derive from DATABASE_URL.
DATABASE_URL_SYNC=

# For a first Render deploy, local storage works but is ephemeral across redeploys.
# Use minio/S3-compatible storage before relying on uploaded samples long-term.
STORAGE_BACKEND=local
STORAGE_DIR=/app/storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sentinel_admin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=sentinel-payloads
MINIO_SECURE=false

REDIS_URL=
USE_CELERY=false

SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_FILE_SIZE_MB=500
