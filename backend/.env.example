APP_NAME=SENTINEL
APP_VERSION=0.1.0
DEBUG=false

# Comma-separated list of allowed browser origins.
# Local: http://localhost:3000
# Production: https://your-vercel-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# Local default can be omitted. Production should use a managed Postgres URL.
# Render commonly provides postgresql://...; the app normalizes it for async use.
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# Optional. Leave blank to derive from DATABASE_URL.
DATABASE_URL_SYNC=

# Local development can use local storage. Render MVP should use minio with Cloudflare R2.
STORAGE_BACKEND=local
STORAGE_DIR=/app/storage

# Cloudflare R2 / S3-compatible object storage.
# Use the host-only endpoint value, without https://.
MINIO_ENDPOINT=<account-id>.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=<r2-access-key-id>
MINIO_SECRET_KEY=<r2-secret-access-key>
MINIO_BUCKET=<r2-bucket-name>
MINIO_SECURE=true

REDIS_URL=
USE_CELERY=false

SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_FILE_SIZE_MB=500
